                },
                "totalPrizesTo": {
                    "type": "number",
                    "description": "Filter by the highest amount of total prizes on the challenge"
                },
                "createdBy": {
                    "type": "string",
                    "description": "Filter by the user who created the challenge"
                },
                "page": {
                    "type": "number",
                    "minimum": 1,
                    "default": 1,
                    "description": "Page number for pagination, starting from 1"
                },
                "perPage": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 20,
                    "description": "Number of challenges per page, between 1 and 100"
                }
            },
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": {
            "type": "object",
            "properties": {
                "page": {
                    "type": "number",
                    "description": "Current page number in the paginated response"
                },
                "nextPage": {
