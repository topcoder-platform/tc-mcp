[
    {
        "name": "query-tc-challenges",
        "description": "Returns a list of Topcoder challenges based on the query parameters.",
        "annotations": {
            "title": "Query Topcoder Challenges",
            "readOnlyHint": true
        },
        "inputSchema": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Filter by challenge ID, exact match."
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "New",
                        "Draft",
                        "Cancelled",
                        "Active",
                        "Completed",
                        "Deleted",
                        "Cancelled - Failed Review",
                        "Cancelled - Failed Screening",
                        "Cancelled - Zero Submissions",
                        "Cancelled - Winner Unresponsive",
                        "Cancelled - Client Request",
                        "Cancelled - Requirements Infeasible",
                        "Cancelled - Zero Registrations"
                    ],
                    "description": "Filter by challenge status"
                },
                "type": {
                    "type": "string",
                    "description": "Filter by type abbreviation, exact match."
                },
                "track": {
                    "type": "string",
                    "description": "Filter by track, case-insensitive, partial matches are allowed."
                },
                "tag": {
                    "type": "string",
                    "description": "Filter by tag name, case-insensitive, partial matches are allowed."
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Filter by multiple tag names, case-insensitive, partial matches are allowed."
                },
                "search": {
                    "type": "string",
                    "description": "Filter by name, description and tags fields, case-insensitive, partial matches are allowed."
                },
                "startDateStart": {
                    "type": "string",
                    "description": "Filter by start date (lower bound of date range, ISO format)"
                },
                "startDateEnd": {
                    "type": "string",
                    "description": "Filter by start date (upper bound of date range, ISO format)"
                },
                "currentPhaseName": {
                    "type": "string",
                    "description": "Filter by current phase name."
                },
                "sortBy": {
                    "type": "string",
                    "enum": [
                        "updatedBy",
                        "updated",
                        "createdBy",
                        "created",
                        "endDate",
                        "startDate",
                        "projectId",
                        "name",
                        "typeId",
                        "numOfRegistrants",
                        "numOfSubmissions",
                        "status",
                        "overview.totalPrizes"
